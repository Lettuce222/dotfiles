.emacs.d/elpa

.emacs.d/eln-cache/30.2-659beb9a
.emacs.d/auto-save-list
.emacs.d/recentf
.emacs.d/projectile-bookmarks.eld
.emacs.d/forge-database.sqlite
.emacs.d/transient/
.emacs.d/.cache/
.emacs.d/history

# Fish shell - environment-specific configurations
configs/fish/**/*.local.fish
configs/fish/functions/local/
configs/fish/fish_variables

# Claude - local settings (machine-specific)
configs/claude/settings.local.json

# mise - config.toml is written by the work Mac's Jamf policy (pmsec);
# dotfiles' own settings live in config.local.toml, which mise reads with higher priority
configs/mise/config.toml

# git - configs/git/ignore is the global gitignore that tools append to
# (Claude Code adds **/.claude/.cc-writes/); install.sh writes the tracked
# rules from configs/git/ignore.shared into a marked block at its top
configs/git/ignore

# Hammerspoon - personal layout configuration
configs/hammerspoon/layouts.yml

# Karabiner - automatic backups
configs/karabiner/automatic_backups/

# textlint - npm packages (installed by install.sh)
configs/textlint/node_modules/

# Python bytecode (tests under configs/)
__pycache__/

# Backup files
*.bak
