;; Both keyboards use F13 for Cmd and F14 for Emacs editing.
(defcfg process-unmapped-keys yes)
(defsrc lctl rctl lmet ralt f13 f14)
(defvirtualkeys cmd-switch-alt lalt)
(defalias
  emacs (layer-while-held emacs)
  ctrl-ime-off (tap-hold-press 200 200 (arbitrary-code 26) lctl)
  ctrl-ime-on (tap-hold-press 200 200 (arbitrary-code 22) rctl)
  ;; Physical left Win/right Alt tap for IME and otherwise keep the native modifiers.
  win-ime-off (tap-hold-press 200 200 (arbitrary-code 26) lmet)
  alt-ime-on (tap-hold-press 200 200 (arbitrary-code 22) ralt)
  ;; Both keyboards send F13 for Cmd; on Windows it acts as left Ctrl.
  corne-cmd (tap-hold-press 200 200 (arbitrary-code 26)
              (multi lctl (layer-while-held corne-cmd-chords)
                     (on-release release-vkey cmd-switch-alt)))
  kill-line (macro S-end 20 RC-x)
)
(deflayer base @ctrl-ime-off @ctrl-ime-on @win-ime-off @alt-ime-on @corne-cmd @emacs)
(deflayermap (emacs)
  f (fork right f (lctl rctl lshift rshift lalt ralt lmet rmet))
  b (fork left b (lctl rctl lshift rshift lalt ralt lmet rmet))
  n (fork down n (lctl rctl lshift rshift lalt ralt lmet rmet))
  p (fork up p (lctl rctl lshift rshift lalt ralt lmet rmet))
  a (fork home a (lctl rctl lshift rshift lalt ralt lmet rmet))
  e (fork end e (lctl rctl lshift rshift lalt ralt lmet rmet))
  d (fork del d (lctl rctl lshift rshift lalt ralt lmet rmet))
  h (fork bspc h (lctl rctl lshift rshift lalt ralt lmet rmet))
  j (fork S-ret j (lctl rctl lshift rshift lalt ralt lmet rmet))
  i (fork tab i (lctl rctl lshift rshift lalt ralt lmet rmet))
  m (fork ret m (lctl rctl lshift rshift lalt ralt lmet rmet))
  v (fork pgdn v (lctl rctl lshift rshift lalt ralt lmet rmet))
  [ (fork esc [ (lctl rctl lshift rshift lalt ralt lmet rmet))
  ] (fork esc ] (lctl rctl lshift rshift lalt ralt lmet rmet))
  y (fork RC-v y (lctl rctl lshift rshift lalt ralt lmet rmet))
  w (fork RC-x w (lctl rctl lshift rshift lalt ralt lmet rmet))
  s (fork RC-f s (lctl rctl lshift rshift lalt ralt lmet rmet))
  g (fork esc g (lctl rctl lshift rshift lalt ralt lmet rmet))
  / (fork RC-z / (lctl rctl lshift rshift lalt ralt lmet rmet))
  k (fork @kill-line k (lctl rctl lshift rshift lalt ralt lmet rmet))
)

;; Mac-style exceptions to the physical Corne thumb's Windows Ctrl behavior.
(deflayermap (corne-cmd-chords)
  ;; Switcher: drop Ctrl on the first Tab, then keep Alt down until F13 is up.
  ;; Once Alt is held, each successive Tab uses the existing switcher session.
  tab (fork (multi lalt (on-press press-vkey cmd-switch-alt) (release-key lctl) tab)
            tab (lalt))
  z (fork z (unmod (lshift rshift) y) (lshift rshift))
)
