# Window
macos-option-as-alt = true

# Cursor
cursor-style = bar
cursor-style-blink = false

# Scrollback
scrollback-limit = 100000

# Font
font-family = "UDEV Gothic NF"
font-size = 14
adjust-cell-height = 2

# Theme
theme = TokyoNight Storm

# Split
split-divider-color = 414868

# Keybindings
keybind = ctrl+backslash=new_split:right
keybind = ctrl+minus=new_split:down

# Links
# OSC 8 のリンクは tmux のクリック（configs/tmux/scripts/open-link.sh）で開く。
# Ghostty の Cmd+クリックは macOS の既定アプリで開くので、file:// の .md などが
# 意図しないアプリに渡らないよう OSC 8 を無効にする。URL の文字列そのものは
# 従来どおり Cmd+クリックでブラウザが開く（link-url）。
link-osc8 = false

# Misc
confirm-close-surface = false
