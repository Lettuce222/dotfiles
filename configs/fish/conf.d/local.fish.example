# Environment-specific configuration example
#
# Copy this file to *.local.fish (e.g., machine.local.fish)
# These files are automatically loaded and excluded from git.
#
# Example usage:
#   cp local.fish.example machine.local.fish
#   # Edit machine.local.fish with your environment-specific settings

# Example: Machine-specific abbreviations
# abbr ssh-example 'ssh user@host.example.com'

# Example: Environment-specific paths
# set -gx CUSTOM_PATH /opt/local-tools/bin
# fish_add_path $CUSTOM_PATH

# Example: API keys or tokens (use with caution)
# set -gx EXAMPLE_API_KEY "your-api-key-here"

# Example: Custom functions
# function project_setup
#     cd ~/projects/example
#     tmuxinator start example
# end
