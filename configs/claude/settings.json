{
  "fileSuggestion": {
    "type": "command",
    "command": "~/.claude/file-suggestion.sh"
  },
  "env": {
    "ENABLE_TOOL_SEARCH": "true",
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  },
  "permissions": {
    "allow": [
      "WebSearch",
      "Read(~/.claude/**)",
      "Edit(~/.claude/**)",
      "Write(~/.claude/**)",
      "Bash(cat:*)",
      "Bash(gitleaks detect:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(mkdir:*)",
      "Bash(ls:*)",
      "Bash(git add:*)",
      "Bash(git add * && git commit:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git pull --ff-only:*)",
      "Bash(git -C * pull --ff-only:*)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:zenn.dev)",
      "Bash(pbcopy:*)",
      "Bash(cat*|*pbcopy)",
      "Bash(ghq get:*)"
    ],
    "deny": [
      "Bash(printenv*)",
      "Bash(env*)",
      "Bash(export*)",
      "Bash(set*)",
      "Bash(echo $*)",
      "Bash(cat .env*)",
      "Bash(**/env)",
      "Bash(**/printenv)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/update-tmux-window-title.sh 🟡",
            "timeout": 3
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/update-tmux-window-title.sh 🔴",
            "timeout": 3
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/textlint-mcp.sh",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/external-post-guard.py",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*gh *)",
            "command": "~/.claude/hooks/external-post-guard.py",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/tmux-socket-guard.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^(Bash|Write|Edit|MultiEdit|NotebookEdit|mcp__.*)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/approval-gate.py pre",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/ask-preview-guard.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/approval-gate.py permission",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/textlint-markdown.sh",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/update-tmux-window-title.sh 🟢",
            "timeout": 3
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/clear-tmux-window-title.sh",
            "timeout": 3
          }
        ]
      }
    ]
  },
  "enableArtifact": false,
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "example-skills@anthropic-agent-skills": false
  },
  "extraKnownMarketplaces": {
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      }
    }
  },
  "language": "Japanese",
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "preferredNotifChannel": "terminal_bell",
  "teammateMode": "auto",
  "skipAutoPermissionPrompt": true,
  "autoMemoryEnabled": false
}
